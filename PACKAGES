# everything xbps installs into the rootfs; one per line, # comments.
# hos owns the base list: no base-system (it insists on runit-void and a
# vi), no runit-void (hsmd is init; the boot scripts, gettys and
# halt/reboot/shutdown are hos's, in overlay/), no dracut (hos-mkinitramfs).

# base: what a shell session and the boot script need
base-files
ncurses
libgcc
coreutils
findutils
diffutils
dash
bash
grep
gzip
file
sed
gawk
less
util-linux
which
tar
man-pages
mdocml
shadow
e2fsprogs
dosfstools
procps-ng
tzdata
pciutils
usbutils
iana-etc
iproute2
iputils
kbd
kmod
eudev
sudo
openssh
xbps
glibc-locales
# sv and chpst: Void's run scripts use them, hsmd speaks their protocol
runit

# kernel and all firmware (linux-base is the firmware set; its dracut
# dependency is held back in IGNORE)
linux
linux-base
wifi-firmware

# hos-mkinitramfs on an installed system (kernel updates rebuild it)
cpio
zstd

