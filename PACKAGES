# everything xbps installs into the rootfs; one per line, # comments.
# hos owns the base list: no base-system (it insists on runit-void and a
# vi), no runit-void (hsmd is init; the boot scripts, gettys and
# halt/reboot/shutdown are hos's, in overlay/), no dracut (hos-mkinitramfs).

# base: what a shell session and the boot script need
base-files
ncurses
libgcc
coreutils
findutils
diffutils
dash
bash
grep
gzip
file
sed
gawk
less
util-linux
which
tar
man-pages
mdocml
shadow
e2fsprogs
dosfstools
procps-ng
tzdata
pciutils
usbutils
iana-etc
iproute2
iputils
kbd
kmod
eudev
sudo
openssh
xbps
glibc-locales
# sv and chpst: Void's run scripts use them, hsmd speaks their protocol
runit

# kernel and all firmware (linux-base is the firmware set; its dracut
# dependency is held back in IGNORE)
linux
linux-base
wifi-firmware

# hos-mkinitramfs on an installed system (kernel updates rebuild it)
cpio
zstd

# X
xorg-minimal
xinit
mesa-dri
dejavu-fonts-ttf
dbus
NetworkManager
# the display manager of an installed hos (hos-install enables it; the
# live system autologs in on tty1 and never starts it): xdm's greeter,
# xrdb to load its look, xsetroot for its ground, pam_rundir for the
# session's XDG_RUNTIME_DIR (overlay/etc/pam.d/xdm)
xdm
xrdb
xsetroot
pam_rundir

# login shell (/etc/default/useradd); hwm's autostart also runs through
# /bin/zsh -c — without it hbg/htray/hnd never start. The rest are what
# that list invokes.
zsh
zsh-autosuggestions
zsh-syntax-highlighting
setxkbmap
xset
xss-lock
slock

# hackable tool runtime deps (fontconfig: hterm resolves its font family
# with fc-match)
SDL2
SDL2_ttf
fontconfig
libXft
fzf
libwebkit2gtk41
alsa-lib
vulkan-loader
# hai's notify tool execs notify-send; hnd is the daemon behind it
libnotify
# sound: hwm's autostart runs pipewire; overlay/etc/pipewire/pipewire.conf.d
# makes it launch wireplumber and pipewire-pulse itself. hwm's volume keys
# run wpctl, its brightness keys brightnessctl
pipewire
wireplumber
brightnessctl
# lid, power and sleep buttons: overlay/etc/acpi/handler.sh, suspend is
# hos's own zzz (runit-void's stays home)
acpid
# alsamixer/amixer beside pipewire; xrandr for external monitors (hbg and
# hwm read the same RandR state); bluetoothd + bluetoothctl (its D-Bus
# policy admits the bluetooth group, mkrootfs puts the user in it);
# chronyd keeps the clock, a service each
alsa-utils
xrandr
bluez
chrony

# toolchain — /usr/src/hackable is meant to be rebuilt in place
gcc
make
pkg-config
git
cmake

# branding: /etc/fastfetch/config.jsonc draws /usr/share/hos/logo.txt
fastfetch

# fetching things
curl
wget

# hed's optional helpers
ripgrep
ctags

# terminal multiplexer, default config in /etc/tmux.conf
tmux

# password store (pulls gnupg); xclip is what pass -c and the tmux
# config copy through
pass
xclip

# file manager in the terminal (uses fzf/ripgrep above when present)
yazi

# headers for rebuilding every tool on the running system
libX11-devel
libXrandr-devel
libXrender-devel
libXcomposite-devel
libXdamage-devel
libXfixes-devel
libXtst-devel
libXft-devel
libinput-devel
eudev-libudev-devel
dbus-devel
SDL2-devel
SDL2_ttf-devel
openssl-devel
libcurl-devel
sqlite-devel
alsa-lib-devel
vulkan-loader-devel
libwebkit2gtk41-devel
# hstt's whisper.cpp vulkan backend compiles shaders at build time
shaderc
SPIRV-Headers

# hos-install puts grub on the target (efibootmgr comes with grub-x86_64-efi)
grub
grub-x86_64-efi
