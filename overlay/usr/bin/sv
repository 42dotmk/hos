#!/bin/sh
# sv(8) lookalike for hsm.  Void's run scripts say "sv check dbus" (and
# people type "sv restart foo" or "sv up /var/service/foo"); each service
# is forwarded to hsm by its basename.  Timing flags like -w are ignored.

usage() {
    echo "usage: sv [-w SECONDS] up|down|restart|check|status SERVICE..." >&2
    exit 100
}

while [ $# -gt 0 ]; do
    case $1 in
    -w) shift 2 ;;
    -*) shift ;;
    *) break ;;
    esac
done
[ $# -ge 1 ] || usage
cmd=$1
shift

[ $# -eq 0 ] && exec hsm "$cmd"
rc=0
for s; do
    s=${s%/}; hsm "$cmd" "${s##*/}" || rc=$?
done
exit $rc
