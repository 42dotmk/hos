#!/bin/sh
# hos: shutdown(8) enough for habit and for tools that call it.
#   shutdown -h|-P now   poweroff      shutdown -r now   reboot
#   shutdown -H now      halt          (a time other than now: after sleeping)
action=poweroff when=
for a; do
    case $a in
    -h | -P | --poweroff) action=poweroff ;;
    -r | --reboot) action=reboot ;;
    -H | --halt) action=halt ;;
    -c) echo "shutdown: nothing scheduled to cancel" >&2; exit 1 ;;
    -*) ;;
    now) when= ;;
    +*) when=$((${a#+} * 60)) ;;
    *) ;;
    esac
done
[ -n "$when" ] && sleep "$when"
exec hsm "$action"
