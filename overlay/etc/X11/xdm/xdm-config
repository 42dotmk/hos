! hos: xdm's configuration - Void's, with the session and the setup
! pointed at hos's scripts beside this file (Xsession, Xsetup_0), and no
! XDMCP (requestPort 0): one local display, the greeter on vt7 (Xservers).
! The live system autologs in on tty1 instead; hos-install enables xdm
! (/var/service/xdm) on the disk.
DisplayManager.authDir:		/var/lib/xdm
DisplayManager.errorLogFile:	/var/log/xdm.log
DisplayManager.pidFile:		/run/xdm.pid
DisplayManager.keyFile:		/etc/X11/xdm/xdm-keys
DisplayManager.servers:		/etc/X11/xdm/Xservers
DisplayManager.accessFile:	/etc/X11/xdm/Xaccess
DisplayManager*resources:	/etc/X11/xdm/Xresources
DisplayManager*authorize:	true
DisplayManager*startup:		/usr/lib64/X11/xdm/Xstartup
DisplayManager*session:		/etc/X11/xdm/Xsession
DisplayManager*reset:		/usr/lib64/X11/xdm/Xreset
DisplayManager*authComplain:	true
DisplayManager._0.setup:	/etc/X11/xdm/Xsetup_0
DisplayManager._0.startup:	/etc/X11/xdm/Xstartup_0
DisplayManager._0.reset:	/usr/lib64/X11/xdm/TakeConsole
DisplayManager*loginmoveInterval:	0
DisplayManager.requestPort:	0
