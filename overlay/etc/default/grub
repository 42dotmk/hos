#
# Configuration file for GRUB.
#
# hos: read by grub-mkconfig when void-installer puts hos on a disk.
# init=/usr/bin/hsmd keeps hsmd pid 1 as on the live cmdline; without it
# runit would boot and start hsmd as its stage 2 (/etc/runit/2).
GRUB_DEFAULT=0
#GRUB_HIDDEN_TIMEOUT=0
#GRUB_HIDDEN_TIMEOUT_QUIET=false
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="hos"
GRUB_CMDLINE_LINUX_DEFAULT="loglevel=4 init=/usr/bin/hsmd"
# Uncomment to use basic console
#GRUB_TERMINAL_INPUT=console
# Uncomment to disable graphical terminal
#GRUB_TERMINAL_OUTPUT=console
#GRUB_BACKGROUND=/usr/share/void-artwork/splash.png
#GRUB_GFXMODE=1920x1080x32
#GRUB_DISABLE_LINUX_UUID=true
#GRUB_DISABLE_RECOVERY=true
